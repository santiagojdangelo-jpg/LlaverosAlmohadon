# ─────────────────────────────────────────────────────────────
#  VARIABLES DE ENTORNO  (⚠️ acá van tus datos)
#
#  1. Copiá este archivo como `.env.local` para desarrollo local.
#  2. En Vercel: Project → Settings → Environment Variables
#     y cargá estas variables con los mismos nombres.
#     (Después de cambiarlas hay que hacer un nuevo Deploy.)
# ─────────────────────────────────────────────────────────────

# ── Cloudinary ───────────────────────────────────────────────
# Cloud name: Cloudinary → Dashboard (arriba a la izquierda).
# Upload preset: Cloudinary → Settings → Upload → Upload presets
#   → "Add upload preset" → Signing Mode = **Unsigned**.
# No hace falta el API Secret: la subida es sin firma, y NUNCA
# pongas el API Secret en variables NEXT_PUBLIC_*.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=TU_UPLOAD_PRESET

# ── TiendaNube ───────────────────────────────────────────────
# URL a la que vuelve el cliente al terminar (carrito, checkout o
# página del producto).
NEXT_PUBLIC_TIENDANUBE_URL=https://tutienda.tiendanube.com/cart/

# (Opcional) URL aparte para el LLAVERO. Si no la cargás, usa la de arriba.
NEXT_PUBLIC_TIENDANUBE_URL_LLAVERO=https://tutienda.tiendanube.com/productos/llavero-almohadon/
